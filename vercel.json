{
  "version": 2,
  "framework": null,
  "builds": [
    { "src": "public/**/*", "use": "@vercel/static" },

    { "src": "api/blob-upload.js", "use": "@vercel/edge" },

    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
